#include "Sensors/inc/IMU.hpp"
#include "stm32f4xx_hal.h"

constexpr uint8_t IMU_CTRL1_ACC_REG = 0x10; // Accelerometer
constexpr uint8_t IMU_CTRL2_GYRO_REG = 0x11; // Gyroscope

void IMU::Initialize(IMU_UPDATE_RATES p_update_rate, IMU_ACC_SCALE p_acc_scale,
		IMU_GYRO_SCALE p_gyro_scale)
{
	HAL_GPIO_WritePin(cs_port, cs_pin, GPIO_PIN_SET);

	update_rate = p_update_rate;
	acc_scale = p_acc_scale;
	gyro_scale = p_gyro_scale;

	Handle_Acc_Control_Registers();
	Handle_Gyro_Control_Registers();
}

void IMU::DMA_TxRxCompleteCallback()
{
	HAL_GPIO_WritePin(cs_port, cs_pin, GPIO_PIN_SET);
}

void IMU::DMA_ErrorCallback()
{
	HAL_GPIO_WritePin(cs_port, cs_pin, GPIO_PIN_SET);
}

void IMU::Handle_Acc_Control_Registers()
{
	current_transmit_buffer[0] = Get_Write_Command(IMU_CTRL1_ACC_REG);
	current_transmit_buffer[1] = static_cast<uint8_t>(update_rate) | static_cast<uint8_t>(acc_scale);

	HAL_GPIO_WritePin(cs_port, cs_pin, GPIO_PIN_RESET);
	HAL_SPI_Transmit(spi, current_transmit_buffer, IMU_BUFFER_SIZE, HAL_MAX_DELAY);
	HAL_GPIO_WritePin(cs_port, cs_pin, GPIO_PIN_SET);
}


void IMU::Handle_Gyro_Control_Registers()
{
	current_transmit_buffer[0] = Get_Write_Command(IMU_CTRL2_GYRO_REG);
	current_transmit_buffer[1] = static_cast<uint8_t>(update_rate) | static_cast<uint8_t>(gyro_scale);

	HAL_GPIO_WritePin(cs_port, cs_pin, GPIO_PIN_RESET);
	HAL_SPI_Transmit(spi, current_transmit_buffer, IMU_BUFFER_SIZE, HAL_MAX_DELAY);
	HAL_GPIO_WritePin(cs_port, cs_pin, GPIO_PIN_SET);
}

