#include "Sensors/inc/Sensor.hpp"



Sensor::Sensor(){}

void Sensor::Setup(SPI_HandleTypeDef* hspi, GPIO_TypeDef* cs_port_spi, uint16_t cs_pin_spi)
{
	spi = hspi;
	cs_port = cs_port_spi;
	cs_pin = cs_pin_spi;
}


bool Sensor::Is_Data_Ready()
{
	return data_ready;
}

uint8_t Sensor::Get_Write_Command(uint8_t message)
{
	return message;
}

uint8_t Sensor::Get_Read_Command(uint8_t message)
{
	return message & 0x7F;
}
