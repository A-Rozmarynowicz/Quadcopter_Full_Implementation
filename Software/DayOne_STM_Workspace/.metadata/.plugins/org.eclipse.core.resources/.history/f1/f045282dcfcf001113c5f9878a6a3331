#include "Sensors/inc/IMU.hpp"
#include "stm32f4xx_hal.h"

constexpr uint8_t IMU_WHOAMI_REG = 0x0F; // Product ID
constexpr uint8_t IMU_CTRL1_ACC_REG = 0x10; // Accelerometer settings
constexpr uint8_t IMU_CTRL2_GYRO_REG = 0x11; // Gyroscope settings

constexpr uint8_t IMU_TEMP_REG = 0x20; // Temperature read register
constexpr uint8_t IMU_MEASUREMENT_REG = 0x22; // Temperature read register

constexpr uint8_t TARGET_WHOAMI_VALUE = 0x6c;

enum MEASUREMENT_DATA_LAYOUT
{
	OUTX_L_G = 1,
	OUTX_H_G,
	OUTY_L_G,
	OUTY_H_G,
	OUTZ_L_G,
	OUTZ_H_G,

	OUTX_L_A,
	OUTX_H_A,
	OUTY_L_A,
	OUTY_H_A,
	OUTZ_L_A,
	OUTZ_H_A,
};

SENSOR_STATUS IMU::Initialize(IMU_UPDATE_RATES p_update_rate, IMU_ACC_SCALE p_acc_scale,
		IMU_GYRO_SCALE p_gyro_scale)
{
	HAL_GPIO_WritePin(cs_port, cs_pin, GPIO_PIN_SET);

	update_rate = p_update_rate;
	acc_scale = p_acc_scale;
	gyro_scale = p_gyro_scale;

	bool id_ok = Assert_ID_Register();
	HAL_StatusTypeDef acc_code = Handle_Acc_Control_Registers();
	HAL_StatusTypeDef gyro_code = Handle_Gyro_Control_Registers();

	if (acc_code == HAL_OK && gyro_code == HAL_OK && id_ok == true)
	{
		return SENSOR_STATUS::INIT_OK;
	}
	return SENSOR_STATUS::INIT_FAIL;
}

void IMU::DMA_TxRxCompleteCallback()
{
	Parse_Measurement(current_receive_buffer);
	HAL_GPIO_WritePin(cs_port, cs_pin, GPIO_PIN_SET);
}

void IMU::DMA_ErrorCallback()
{
	HAL_GPIO_WritePin(cs_port, cs_pin, GPIO_PIN_SET);
}

HAL_StatusTypeDef IMU::Handle_Acc_Control_Registers()
{
	current_transmit_buffer[0] = Get_Write_Command(IMU_CTRL1_ACC_REG);
	current_transmit_buffer[1] = static_cast<uint8_t>(update_rate) | static_cast<uint8_t>(acc_scale);

	HAL_GPIO_WritePin(cs_port, cs_pin, GPIO_PIN_RESET);
	HAL_StatusTypeDef code = HAL_SPI_Transmit(spi, current_transmit_buffer, IMU_BUFFER_SIZE, HAL_MAX_DELAY);
	HAL_GPIO_WritePin(cs_port, cs_pin, GPIO_PIN_SET);

	Change_Buffer_Pointers();

	return code;
}


HAL_StatusTypeDef IMU::Handle_Gyro_Control_Registers()
{
	current_transmit_buffer[0] = Get_Write_Command(IMU_CTRL2_GYRO_REG);
	current_transmit_buffer[1] = static_cast<uint8_t>(update_rate) | static_cast<uint8_t>(gyro_scale);

	HAL_GPIO_WritePin(cs_port, cs_pin, GPIO_PIN_RESET);
	HAL_StatusTypeDef code = HAL_SPI_Transmit(spi, current_transmit_buffer, IMU_BUFFER_SIZE, HAL_MAX_DELAY);
	HAL_GPIO_WritePin(cs_port, cs_pin, GPIO_PIN_SET);

	Change_Buffer_Pointers();

	return code;
}

bool IMU::Assert_ID_Register()
{
	current_transmit_buffer[0] = Get_Read_Command(IMU_WHOAMI_REG);

	HAL_GPIO_WritePin(cs_port, cs_pin, GPIO_PIN_RESET);
	HAL_StatusTypeDef code = HAL_SPI_TransmitReceive(spi, current_transmit_buffer, current_receive_buffer,
			IMU_BUFFER_SIZE, HAL_MAX_DELAY);
	HAL_GPIO_WritePin(cs_port, cs_pin, GPIO_PIN_SET);

	bool ok = current_receive_buffer[1] == TARGET_WHOAMI_VALUE;

	Change_Buffer_Pointers();

	return (code == HAL_OK) && (ok == true);
}

void IMU::Prepare_For_Measurements()
{
	for (uint8_t i = 0; i<IMU_BUFFER_SIZE; i++)
	{
		transmit_buffer_1[i] = 0;
		transmit_buffer_2[i] = 0;
	}
	transmit_buffer_1[0] = Get_Read_Command(IMU_MEASUREMENT_REG);
	transmit_buffer_2[0] = Get_Read_Command(IMU_MEASUREMENT_REG);
}

void IMU::Measurement_Cycle_Finished()
{
	Change_Buffer_Pointers();
}

bool IMU::Parse_Measurement(uint8_t* received_data, uint8_t size)
{
	if (size != IMU_BUFFER_SIZE)
	{
		return false;
	}

	raw_A_x = (int16_t) (received_data[OUTX_H_A] << 8 | received_data[OUTX_L_A]);
	raw_A_y = (int16_t) (received_data[OUTY_H_A] << 8 | received_data[OUTY_L_A]);
	raw_A_z = (int16_t) (received_data[OUTZ_H_A] << 8 | received_data[OUTZ_L_A]);

	raw_G_x = (int16_t) (received_data[OUTX_H_G] << 8 | received_data[OUTX_L_G]);
	raw_G_y = (int16_t) (received_data[OUTY_H_G] << 8 | received_data[OUTY_L_G]);
	raw_G_z = (int16_t) (received_data[OUTZ_H_G] << 8 | received_data[OUTZ_L_G]);

	float acc_sensitivity_mg, gyro_sensitivity_mdps;
	Get_Sensitivities(acc_sensitivity_mg, gyro_sensitivity_mdps);

}

void IMU::Get_Sensitivities(float &acc_sensitivity_mg, float &gyro_sensitivity_mdps)
{
	switch (acc_scale)
	{
		case IMU_ACC_SCALE::G_8:
			acc_sensitivity_mg = 0.244f;
			break;
		case IMU_ACC_SCALE::G_16:
			acc_sensitivity_mg = 0.488f;
			break;
	}
	switch (gyro_scale)
	{
		case IMU_GYRO_SCALE::DPS_500:
			gyro_sensitivity_mdps = 17.50f;
			break;
		case IMU_ACC_SCALE::G_16:
			gyro_sensitivity_mdps = 35.0f;
			break;
	}

}



void IMU::Task_Perform_Transaction()
{
	HAL_SPI_TransmitReceive_DMA(hspi, current_transmit_buffer, current_receive_buffer, IMU_BUFFER_SIZE);
}
